    },
    "Trening i sve unesene serije bit će obrisani." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The workout and all entered sets will be deleted."
          }
        }
      }
    },
    "Trening je ostao otvoren. Možeš ga nastaviti, završiti ili odbaciti." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A workout was left open. You can resume, finish or discard it."
          }
        }
      }
    },
    "Trening je otvoren dulje od 6 sati bez aktivnosti. Završi ga na zadnjoj završenoj seriji ili ga odbaci." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The workout has been open for more than 6 hours without activity. Finish it at the last completed set or discard it."

    },
    "Trening i njegove serije bit će trajno obrisani, a rekordi i statistika preračunat će se bez njega." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The workout and its sets will be permanently deleted, and records and statistics will be recalculated without it."
          }
        }
      }
    },
    "Trening i sve serije bit će obrisani." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The workout and all its sets will be deleted."
          }
        }

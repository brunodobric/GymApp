      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Running"
          }
        }
      }
    },
    "Tvrde serije su radne serije bez onih s RPE ispod 6. Kardio vježbe se ne broje u serije." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hard sets are working sets, excluding those with RPE below 6. Cardio exercises don't count as sets."
          }
        }
      }
    },
    "U Dopuštenim obavijestima dodaj Apolon, da obavijest o kraju odmora i dalje stiže." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add Apolon under Allowed Notifications so the end-of-rest notification still comes through."
          }
        }
      }
    },
    "U ovom mjesecu nema odrađenih treninga." : {
      "localizations" : {

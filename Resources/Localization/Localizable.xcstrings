    "Sustav" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System"
          }
        }
      }
    },
    "Sustav jednom dnevno pripremi izvještaj o radu aplikacije (pokretanje, memorija, baterija), a nakon rušenja ili zastoja i izvještaj o grešci. Izvještaji ostaju na ovom uređaju i ne sadrže tvoje treninge. Možeš ih izvesti i poslati uz prijavu greške." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once a day the system prepares a report on how the app runs (launch, memory, battery), and after a crash or hang, an error report. Reports stay on this device and don't contain your workouts. You can export them and send them with a bug report."
          }
        }
      }
    },
    "Sve" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {

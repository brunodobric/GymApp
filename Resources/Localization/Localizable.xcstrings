    "%@ stoji 4 tjedna uz više od 20 tvrdih serija tjedno. Manje serija ili lakši tjedan može pomoći oporavku." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ has been steady for 4 weeks with more than 20 hard sets per week. Fewer sets or an easier week can help recovery."
          }
        }
      }
    },
    "%@ stoji 4 tjedna, a mišić ima manje od 10 tvrdih serija tjedno. Više serija daje više napretka (Pelland i sur. 2024)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ has been steady for 4 weeks, and the muscle gets fewer than 10 hard sets per week. More sets bring more progress (Pelland et al. 2024)."

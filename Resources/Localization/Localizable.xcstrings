    "Tema" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theme"
          }
        }
      }
    },
    "Tema vrijedi za zaključani zaslon. Dynamic Island je uvijek crn, pa se ondje mijenja samo boja." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The theme applies to the Lock Screen. The Dynamic Island is always black, so only the color changes there."
          }
        }
      }
    },
    "Težina" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weight"
          }
        }
      }
    },
    "Težina se interno uvijek sprema u kilogramima, pa jedinicu možeš kasnije promijeniti u Postavkama." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weight is always stored in kilograms internally, so you can change the unit later in Settings."
          }
        }
      }
    },
    "Težina serije prema najboljoj procjeni 1RM vježbe, zadnja 4 tjedna. Iznad 85 posto je trening maksimalne snage." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set weight relative to the exercise's best estimated 1RM, last 4 weeks. Above 85 percent is maximal strength training."
          }
        }
      }
    },
    "Težina × ponavljanja" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weight × reps"
          }
        }
      }
    },
    "Težina, opsezi i vlastite mjere s grafovima." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weight, circumferences and custom measurements with charts."
          }
        }
      }
    },
    "Težina, procjena 1RM i volumen kroz vrijeme za jednu vježbu." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weight, estimated 1RM and volume over time for one exercise."
          }
        }
      }

      }
    },
    "Trening se nije mogao stvoriti." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The workout couldn't be created."
          }
        }
      }
    },
    "Trening se pokreće na satu u aplikaciji Workout. Kad ga završiš, Apollo ga uvozi iz Zdravlja i raspored ide dalje." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The workout starts on the watch in the Workout app. When you finish it, Apollo imports it from Health and the schedule moves on."
          }
        }
      }
    },
    "Trening se pokreće na satu u aplikaciji Workout. U rasporedu ga Apollo zakazuje na sat za termin podsjetnika." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The workout starts on the watch in the Workout app. In a schedule, Apollo schedules it on the watch at the reminder time."
          }
        }
      }
    },

            "state" : "translated",
            "value" : "Reps in reserve"
          }
        }
      }
    },
    "Ponavljanja u rezervi, zadnja 4 tjedna. Za rast mišića najbolje rade serije blizu otkaza (0 do 3), a za snagu blizina otkaza manje znači (Robinson i sur. 2024)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reps in reserve, last 4 weeks. Sets close to failure (0 to 3) work best for muscle growth, while proximity to failure matters less for strength (Robinson et al. 2024)."
          }
        }
      }
    },
    "Ponavljanja, trajanje i udaljenost" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {

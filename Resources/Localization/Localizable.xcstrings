    "Trening bez ijedne završene serije ne može se spremiti. Ako ga više ne trebaš, obriši ga." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A workout without a completed set can't be saved. If you no longer need it, delete it."

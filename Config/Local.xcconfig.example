// Kopirati u Config/Local.xcconfig (ne commita se) i upisati svoj tim.
// Team ID: Xcode → Settings → Accounts → tim, ili developer.apple.com → Membership.

DEVELOPMENT_TEAM = ABCDE12345

// Samo za besplatni Personal Team (bez plaćenog Apple Developer Programa):
// isključuje iCloud/CloudKit i push, koje Personal Team ne podržava.
// Za plaćeni račun obrisati ova dva retka.
GYMAPP_ENTITLEMENTS_SUFFIX = -PersonalTeam
GYMAPP_EXTRA_CONDITIONS = PERSONAL_TEAM

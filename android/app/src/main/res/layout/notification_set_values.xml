<?xml version="1.0" encoding="utf-8"?>
<!-- Proširena obavijest treninga: tekst serije i do dva retka s gumbima − i + (Live Activity na iOS-u). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/set_text"
        android:textAppearance="@style/TextAppearance.Compat.Notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="3" />

    <LinearLayout
        android:id="@+id/row_first"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/first_minus"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:text="−" />

        <TextView
            android:id="@+id/first_value"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center" />

        <Button
            android:id="@+id/first_plus"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:text="+" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_second"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/second_minus"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:text="−" />

        <TextView
            android:id="@+id/second_value"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center" />

        <Button
            android:id="@+id/second_plus"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:text="+" />
    </LinearLayout>
</LinearLayout>

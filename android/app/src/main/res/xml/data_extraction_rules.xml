<?xml version="1.0" encoding="utf-8"?>
<!--
  Sustavska sigurnosna kopija (Auto Backup u korisnikov Google Drive) i prijenos na novi mobitel:
  samo korisnička baza i slike vlastitih vježbi. Zapis o upisanom u Health Connect (files/health) i
  MoveKit sadržaj ne idu u kopiju (docs/android.md, odjeljci 5 i 6).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="gym.db" />
        <include domain="file" path="exercise-images/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="gym.db" />
        <include domain="file" path="exercise-images/" />
    </device-transfer>
</data-extraction-rules>
